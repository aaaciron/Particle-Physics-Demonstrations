Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "s_", "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", ",", "s"}], "]"}], "*", 
       RowBox[{"Sin", "[", "x", "]"}], "*", "2", "*", "Pi"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0.0001", ",", "Pi"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"y", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"100", "*", "\[Alpha]"}]}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<W\>\"", ",", "\"\<\[Sigma]\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Se\[CCedilla]\[ATilde]o de choque total\>\""}], ",",
      " ", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}]}]], "Input",
