}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"p", ",", "q"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], "^", "2"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], 
     RowBox[{"En", "[", "k", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"k", ",", "q"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], 
     RowBox[{"En", "[", "k", "]"}]}], "-", 
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}], "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"q", ",", "q"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], "^", "2"}], " ", "-", " ", 
    RowBox[{"2", 
     RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], 
     RowBox[{"En", "[", "k", "]"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}], "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP", "[", 
   RowBox[{"k", ",", "p"}], "]"}], "=", 
  RowBox[{
   RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], 
   RowBox[{"En", "[", "k", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"diffDecayRate3", " ", "//", "Factor2"}]}], "Input",
 CellChangeTimes->{{3.9983127574985867`*^9, 3.998312791181528*^9}, {
  3.998313101728798*^9, 3.9983131425661926`*^9}, {3.9983132161047916`*^9, 
