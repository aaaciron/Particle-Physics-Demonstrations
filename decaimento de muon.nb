Cell["\<\
Now we way reduce the tensor integrals in q1 and q2 to scalar ones by using \
tensor decomposition\
\>", "Text",
 CellChangeTimes->{{3.9982317088789024`*^9, 
  3.9982317476658382`*^9}},ExpressionUUID->"39948ec8-f60c-2649-861d-\
1704a66091a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"q1q2", "[", 
     RowBox[{"mu_", ",", "nu_"}], "]"}], ":=", 
    RowBox[{"ReplaceAll", "[", 
     RowBox[{
      RowBox[{"Tdec", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q1x", ",", "mu"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"q2x", ",", "nu"}], "}"}]}], "}"}], ",", 
        RowBox[{"{", "q", "}"}], ",", 
        RowBox[{"List", "->", "False"}], ",", 
        RowBox[{"Dimension", "->", "4"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"q1x", ",", "q2x"}], "]"}], "->", 
         RowBox[{
          RowBox[{"SP", "[", 
           RowBox[{"q", ",", "q"}], "]"}], "/", "2"}]}], ",", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"q", ",", 
           RowBox[{"q1x", "|", "q2x"}]}], "]"}], "->", 
         RowBox[{
          RowBox[{"SP", "[", 
           RowBox[{"q", ",", "q"}], "]"}], "/", "2"}]}]}], "}"}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q1q2", "[", 
   RowBox[{"mu", ",", "nu"}], "]"}], "//", "Factor2"}]}], "Input",
 CellChangeTimes->{{3.998231752096731*^9, 3.998231752096731*^9}, 
   3.998231787704157*^9},
 CellLabel->
  "In[143]:=",ExpressionUUID->"0c092d45-3bdd-eb43-ae7d-2cc8dc128081"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FormBox[
       SuperscriptBox[
        FormBox[
         OverscriptBox[
          FormBox["q",
           TraditionalForm], "_"],
         TraditionalForm], "2"],
       TraditionalForm], " ", 
      FormBox[
       SuperscriptBox[
        OverscriptBox["g", "_"], 
        RowBox[{
         FormBox[
          FormBox["mu",
           TraditionalForm],
          TraditionalForm], 
         FormBox[
          FormBox["nu",
           TraditionalForm],
          TraditionalForm]}]],
       TraditionalForm]}], "+", 
     RowBox[{"2", " ", 
      FormBox[
       SuperscriptBox[
        FormBox[
         OverscriptBox[
          FormBox["q",
           TraditionalForm], "_"],
         TraditionalForm], 
        FormBox[
         FormBox["mu",
          TraditionalForm],
         TraditionalForm]],
       TraditionalForm], " ", 
      FormBox[
       SuperscriptBox[
        FormBox[
         OverscriptBox[
          FormBox["q",
           TraditionalForm], "_"],
         TraditionalForm], 
        FormBox[
         FormBox["nu",
          TraditionalForm],
         TraditionalForm]],
       TraditionalForm]}]}], ")"}]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.998231756161398*^9, 3.9982317944453983`*^9, 
  3.998231870471615*^9, 3.9983118190159626`*^9, 3.9984114217350407`*^9, 
  3.9984140000907974`*^9, 3.998414771668255*^9},
 CellLabel->
  "Out[144]=",ExpressionUUID->"350265b1-25c1-cc4a-bf17-cba7e6f865ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"diffDecayRate1", "=", 
  RowBox[{"Uncontract", "[", 
   RowBox[{"diffDecayRate", ",", "q1", ",", "q2", ",", 
    RowBox[{"Pair", "->", "All"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99823180739176*^9, 3.9982318073927937`*^9}},
 CellLabel->
  "In[145]:=",ExpressionUUID->"6c7ae215-0dd4-a042-87d2-6b6503328ef1"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.998231808905607*^9, 3.9982318745935*^9, 
  3.998311819061537*^9, 3.9984114217866745`*^9, 3.998414000162571*^9, 
  3.998414771861168*^9},
 CellLabel->
  "Out[145]=",ExpressionUUID->"d295d37b-9b54-7d47-9cce-27c13e14d688"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"diffDecayRate2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"diffDecayRate1", "//", "FCE"}], ")"}], "/.", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"FV", "[", 
         RowBox[{"q1", ",", "mu_"}], "]"}], " ", 
        RowBox[{"FV", "[", 
         RowBox[{"q2", ",", "nu_"}], "]"}]}], ":>", 
       RowBox[{"q1q2", "[", 
        RowBox[{"mu", ",", "nu"}], "]"}]}]}], ")"}], "//", "Contract"}], "//",
    "FCE"}]}]], "Input",
 CellChangeTimes->{{3.998231894250883*^9, 3.9982318942519073`*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"03d1f694-c175-3c42-ab4e-95fc2b03a667"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.9982318959000683`*^9, 3.9983118191329956`*^9, 
  3.9984114219046154`*^9, 3.9984140003141975`*^9, 3.9984147719527836`*^9},
 CellLabel->
  "Out[146]=",ExpressionUUID->"6661cb1f-5c45-5642-9791-fab2508a3db3"]
}, Open  ]],

Cell["Integrating now we find", "Text",
 CellChangeTimes->{{3.9982319337757607`*^9, 3.9982319480678806`*^9}, {
  3.9982328211327*^9, 3.9982328354751625`*^9}, {3.998232956535055*^9, 
  3.9982329767876167`*^9}},ExpressionUUID->"f979f68d-d272-b247-be5b-\
db002d3b2aeb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"diffDecayRate3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"diffDecayRate2", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d3q2", " ", 
         RowBox[{"delta4", "[", 
          RowBox[{"q", "-", "q1", "-", "q2"}], "]"}]}], "->", 
        RowBox[{"delta", "[", 
         RowBox[{
          RowBox[{"En", "[", "q", "]"}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"En", "[", "q1", "]"}]}]}], "]"}]}], "}"}]}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"En", "[", "q2", "]"}], "->", 
       RowBox[{"En", "[", "q1", "]"}]}], "}"}]}], "/.", " ", 
    RowBox[{"{", 
     RowBox[{"d3q1", "->", 
      RowBox[{"4", " ", "Pi", " ", "dq10", " ", 
       RowBox[{
        RowBox[{"En", "[", "q1", "]"}], "^", "2"}]}]}], "}"}]}], "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"dq10", " ", 
      RowBox[{"delta", "[", 
       RowBox[{
        RowBox[{"En", "[", "q", "]"}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"En", "[", "q1", "]"}]}]}], "]"}]}], "->", 
     RowBox[{"1", "/", "2"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9982319530086823`*^9, 3.9982319530103245`*^9}},
 CellLabel->
  "In[147]:=",ExpressionUUID->"fbe9e922-4546-904b-9c0e-12cc1f2cdab1"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.998231954479965*^9, 3.9983118191746254`*^9, 
  3.9984114219518375`*^9, 3.998414000476698*^9, 3.998414772049017*^9},
 CellLabel->
