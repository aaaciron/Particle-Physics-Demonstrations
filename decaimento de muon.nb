Cell[TextData[{
 "Doing the calculations by hand of using spheric coordinates, then \
substituting k->En and so on so on, we end up with an expression wrote down \
in the ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"L", 
     StyleBox[
      AdjustmentBox["A",
       BoxBaselineShift->-0.4,
       BoxMargins->{{-0.5, -0.3}, {0, 0}}],
      FontSize->Smaller], "T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "deaf4e9a-5c43-3c45-9928-066b52b6a26f"],
 " document \[OpenCurlyDoubleQuote]Intera\[CCedilla]\[OTilde]es Fracas\
\[CloseCurlyDoubleQuote]"
}], "Text",
 CellChangeTimes->{{3.9983155055836067`*^9, 3.99831554960446*^9}, {
  3.998315659176384*^9, 
  3.998315687010233*^9}},ExpressionUUID->"c231a3b4-60ad-cc4f-aee7-\
d0fb549706d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now some figures", "Subtitle",
 CellChangeTimes->{{3.9983157076195602`*^9, 
  3.9983157119007816`*^9}},ExpressionUUID->"911a9639-ca1d-d345-a12a-\
c6540bf91df8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"1.16", "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "5"}], ")"}]}]}]}], " ", 
  RowBox[{"(*", 
   SuperscriptBox["Gev", 
    RowBox[{"-", "2"}]], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"me", "=", 
   RowBox[{"0.51", "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}]}]}], " ", 
  RowBox[{"(*", "GeV", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mmu", "=", 
   RowBox[{"105.65", "*", 
    RowBox[{"10", "^", 
     RowBox[{"(", 
      RowBox[{"-", "3"}], ")"}]}]}]}], 
  RowBox[{"(*", "GeV", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Gam", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"G", "^", "2"}], " ", "/", 
     RowBox[{"(", 
      RowBox[{"12", "*", 
       RowBox[{"Pi", "^", "3"}]}], ")"}]}], ")"}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"3", "*", 
      RowBox[{"me", "^", "2"}], "*", "x"}], "-", 
     RowBox[{"2", "*", 
      RowBox[{"me", "^", "2"}], " ", "*", "mmu"}], "-", 
     RowBox[{"4", "*", 
      RowBox[{"x", "^", "2"}], "*", "mmu"}], "+", 
     RowBox[{"3", "*", 
      RowBox[{"mmu", "^", "2"}], "*", "x"}]}], ")"}], "*", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "-", 
     RowBox[{"me", "^", "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GamAprox", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"G", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"12", "*", 
        RowBox[{"Pi", "^", "3"}]}], ")"}]}], ")"}], "*", 
    RowBox[{"mmu", "^", "2"}], "*", 
    RowBox[{"x", "^", "2"}], 
    RowBox[{"(", 
     RowBox[{"3", " ", "-", " ", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"x", "/", "mmu"}]}], ")"}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Gam", "[", "x", "]"}], ",", 
     RowBox[{"GamAprox", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", 
     RowBox[{"mmu", "/", "2"}]}], "}"}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Taxa de decaimento diferencial \!\(\*SuperscriptBox[\(\[Mu]\), \
\(-\)]\)->\!\(\*SubscriptBox[\(\[Nu]\), \
\(\[Mu]\)]\)\!\(\*OverscriptBox[SubscriptBox[\(\[Nu]\), \(e\)], \
\(_\)]\)\!\(\*SuperscriptBox[\(e\), \(-\)]\)\>\""}], ",", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(E\), \(e\)]\)(GeV)\>\"", 
      ",", "\"\<\!\(\*FractionBox[\(d\[CapitalGamma]\), SubscriptBox[\(dE\), \
\(e\)]]\)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(m\), \(e\)]\)>0\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(m\), \(e\)]\)~0\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9983157182608147`*^9, 3.9983159328817635`*^9}, {
  3.998316025587532*^9, 3.9983160299536343`*^9}, {3.998316163927614*^9, 
