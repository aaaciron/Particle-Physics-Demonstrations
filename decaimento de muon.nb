Cell[CellGroupData[{

Cell["Obtaining the amplitude", "Subtitle",
 CellChangeTimes->{{3.998055389422371*^9, 
  3.998055401000471*^9}},ExpressionUUID->"95b18913-96e5-1c4f-8536-\
759e46937034"],

Cell[TextData[{
 "Here we are calculating considering a massive vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["W", "-"], TraditionalForm]],ExpressionUUID->
  "a4c1f878-fbf0-1f4e-9aaf-e1a39103ed85"],
 " boson, and the spinors are represented by the greek letter \[Phi] besides \
the usual u. Also, p is the muon 4-momentum, k is the electron, q1 is the \
anti electron neutrino and q2 is the muon neutrino."
}], "Text",
 CellChangeTimes->{{3.998055437593151*^9, 3.9980555450184326`*^9}, {
  3.9980577709731293`*^9, 3.998057840545252*^9}, {3.9982309935360966`*^9, 
  3.9982309972088184`*^9}, {3.9982316484890556`*^9, 
  3.9982316514754047`*^9}},ExpressionUUID->"6833d9a4-9801-954c-b248-\
74b9e0d9fe52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"amp", "[", "0", "]"}], "=", 
  RowBox[{"FCFAConvert", "[", 
   RowBox[{
    RowBox[{"CreateFeynAmp", "[", 
     RowBox[{"diags", ",", 
      RowBox[{"GaugeRules", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FAGaugeXi", "[", 
          RowBox[{"W", "|", "Z"}], "]"}], "->", "Infinity"}], "}"}]}]}], 
     "]"}], ",", 
    RowBox[{"IncomingMomenta", "->", 
     RowBox[{"{", "p", "}"}]}], ",", 
    RowBox[{"OutgoingMomenta", "->", 
     RowBox[{"{", 
      RowBox[{"k", ",", "q1", ",", "q2"}], "}"}]}], ",", 
    RowBox[{"ChangeDimension", "->", "4"}], ",", 
    RowBox[{"List", "->", "False"}], ",", 
    RowBox[{"SMP", "->", "True"}], ",", 
    RowBox[{"Contract", "->", "True"}], ",", 
    RowBox[{"DropSumOver", "->", "True"}], ",", 
    RowBox[{"FinalSubstitutions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SMP", "[", "\"\<e\>\"", "]"}], "->", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"8", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], "*", 
         RowBox[{"SMP", "[", "\"\<G_F\>\"", "]"}], "*", 
         RowBox[{
          RowBox[{"SMP", "[", "\"\<m_W\>\"", "]"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{"SMP", "[", "\"\<sin_W\>\"", "]"}], "^", "2"}]}], "]"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.99805540396192*^9, 3.99805540396192*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"bc0ba291-e46b-c340-84a3-6419dd7eee42"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.998055406317648*^9, 3.998231850257904*^9, 
  3.998311817985529*^9, 3.998411420121279*^9, 3.998413999410158*^9, 
  3.998414770780569*^9},
 CellLabel->
  "Out[134]=",ExpressionUUID->"bd12c176-f1f5-254b-889c-1ec8fddafbb1"]
}, Open  ]],

Cell["Now we fix the kinematics", "Text",
 CellChangeTimes->{{3.9980566212895527`*^9, 
  3.9980566294757175`*^9}},ExpressionUUID->"d9f40683-08e2-9443-b2f7-\
93261b357f1d"],

Cell[BoxData[{
 RowBox[{"FCClearScalarProducts", "[", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"k", ",", "k"}], "]"}], "=", 
   RowBox[{
    RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}], "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"q1", ",", "q1"}], "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SP", "[", 
    RowBox[{"q2", ",", "q2"}], "]"}], "=", "0"}], ";"}]}], "Input",
 CellChangeTimes->{{3.998056632148075*^9, 3.998056632148075*^9}},
 CellLabel->
  "In[135]:=",ExpressionUUID->"0ac302b9-d752-714f-9bcd-7ef220c73240"],

Cell["And obtain the amplitude squared spin averege", "Text",
 CellChangeTimes->{{3.998056765641348*^9, 
  3.998056794244894*^9}},ExpressionUUID->"5180e937-c3e4-b240-8f80-\
84200b7dca73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ampSquared", "[", "0", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"amp", "[", "0", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"ComplexConjugate", "[", 
         RowBox[{"amp", "[", "0", "]"}], "]"}], ")"}]}], ")"}], "//", 
     RowBox[{
      RowBox[{"FermionSpinSum", "[", 
       RowBox[{"#", ",", 
        RowBox[{"ExtraFactor", "->", 
         RowBox[{"1", "/", "2"}]}]}], "]"}], "&"}]}], "//", "DiracSimplify"}],
    "//", "Factor"}]}]], "Input",
 CellChangeTimes->{{3.9980567972001762`*^9, 3.9980567972001762`*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"f1f70206-e96d-0844-930c-44fedacb509e"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.9980568001927605`*^9, 3.9982318588760777`*^9, 
  3.9983118185925884`*^9, 3.998411421039917*^9, 3.9984139998683968`*^9, 
  3.9984147709519176`*^9},
 CellLabel->
  "Out[139]=",ExpressionUUID->"8903865c-f159-3544-99dd-0b7934de4bdb"]
}, Open  ]],

Cell["\<\
Lets make our lifes easier by making the low energy approximation typical of \
the scale we\[CloseCurlyQuote]re dealing with.\
\>", "Text",
 CellChangeTimes->{{3.9980591373262615`*^9, 3.998059195913576*^9}, {
  3.998059546354126*^9, 
  3.998059615906685*^9}},ExpressionUUID->"a7fc1201-1a8c-0444-a820-\
a8f4f256dc7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ampSquared", "[", "1", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ampSquared", "[", "0", "]"}], "//", "FCE"}], "//", 
      RowBox[{
       RowBox[{"ReplaceAll", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "+", "q1"}], "->", "0"}], "}"}]}], "]"}], "&"}]}], "//",
      "FeynAmpDenominatorExplicit"}], "//", 
    RowBox[{
     RowBox[{"Series", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"SMP", "[", "\"\<m_W\>\"", "]"}], ",", "Infinity", ",", 
         "0"}], "}"}]}], "]"}], "&"}]}], "//", "Normal"}]}]], "Input",
 CellChangeTimes->{{3.9980592792300034`*^9, 3.998059307582945*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"79df9976-8013-9348-8a2c-e5ad36c5d155"],

Cell[BoxData[
 FormBox["0", TraditionalForm]], "Output",
 CellChangeTimes->{3.9980596235288105`*^9, 3.9982318629619503`*^9, 
  3.9983118189165096`*^9, 3.998411421618738*^9, 3.9984139999465218`*^9, 
  3.99841477104175*^9},
 CellLabel->
  "Out[140]=",ExpressionUUID->"485de433-9c8e-094a-8474-577772f266ff"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["The total decay rate", "Subtitle",
 CellChangeTimes->{{3.998057724030779*^9, 
  3.9980577284831944`*^9}},ExpressionUUID->"e4418c31-6937-5b4f-9401-\
4726b150cb39"],

Cell["\<\
In order to obtain the total decay rate, we need firstly obtain the \
differetial decay rate in terms of the 3-momenta of the outgoing particles. \
(q=p-k)\
\>", "Text",
 CellChangeTimes->{{3.998057746430336*^9, 3.9980577587957535`*^9}, {
  3.9980578468672943`*^9, 3.9980578892666664`*^9}, {3.9980586479448986`*^9, 
  3.9980587498394585`*^9}, {3.998059178355583*^9, 3.998059178806246*^9}, {
  3.9982321628990517`*^9, 
  3.998232171090021*^9}},ExpressionUUID->"13528fb2-a244-6441-b7c4-\
6c5814cdf49d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prefac", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"SMP", "[", "\"\<m_mu\>\"", "]"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}], "^", "5"}], " ", "8"}], ")"}], "^", 
    RowBox[{"-", "1"}]}]}], ";"}], "\n", 
 RowBox[{"diffDecayRate", "=", 
  RowBox[{"prefac", " ", 
   RowBox[{"d3q1", "/", 
    RowBox[{"En", "[", "q1", "]"}]}], " ", 
   RowBox[{"d3q2", "/", 
    RowBox[{"En", "[", "q2", "]"}]}], " ", 
   RowBox[{"d3k", "/", 
    RowBox[{"En", "[", "k", "]"}]}], " ", 
   RowBox[{"delta4", "[", 
    RowBox[{"q", "-", "q1", "-", "q2"}], "]"}], "*", 
   RowBox[{"ampSquared", "[", "1", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.998058389991585*^9, 3.9980584056650295`*^9}, {
  3.998058587699007*^9, 3.9980586267316837`*^9}, {3.998058866755871*^9, 
  3.998058981787691*^9}, {3.9980596457799625`*^9, 3.998059759677311*^9}, {
